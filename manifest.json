{
  "manifest_version": 3,
  "name": "X 推文标注下载助手",
  "version": "1.0.0",
  "description": "在浏览 X 时自动或手动下载优质推文为弱格式 Word 文件（.doc）",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
